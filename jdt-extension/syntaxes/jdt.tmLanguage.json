{
  "name": "JDT Schema",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constraints"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jdt",
          "match": "\\b(is|define|schema|version|owner|type)\\b"
        },
        {
          "name": "keyword.operator.logical.jdt",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.jdt",
          "match": "\\b(string|number|boolean|null|true|false|array|object)\\b"
        }
      ]
    },
    "constraints": {
      "patterns": [
        {
          "name": "storage.modifier.jdt",
          "match": "\\b(required|optional|minimum|maximum|longer|shorter|larger|smaller|match|closed|open|unordered|ordered)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.jdt",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.jdt",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.jdt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jdt",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.jdt",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.jdt"
}
